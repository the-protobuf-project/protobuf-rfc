<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sandbox POM for the generated Java SDK. Copied into gen/java by
  scripts/sandbox-build.sh, which runs `mvn compile`. Compile only: nothing is
  packaged, published or run.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.theprotobufproject</groupId>
  <artifactId>protobuf-rfc-sandbox</artifactId>
  <version>0.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      protoc-gen-java currently emits gencode stamped 4.36.1, which is newer
      than any protobuf-java on Maven Central. That only matters at runtime,
      where the version check lives; this sandbox compiles and never runs, so
      the newest published runtime is the right pin. Declared first so it wins
      over protovalidate's older transitive protobuf-java.
    -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.35.0</version>
    </dependency>
    <!-- google/api and google/longrunning descriptors the schema imports. -->
    <dependency>
      <groupId>com.google.api.grpc</groupId>
      <artifactId>proto-google-common-protos</artifactId>
      <version>2.72.0</version>
    </dependency>
    <!-- buf/validate. -->
    <dependency>
      <groupId>build.buf</groupId>
      <artifactId>protovalidate</artifactId>
      <version>0.7.0</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}</sourceDirectory>
  </build>
</project>
